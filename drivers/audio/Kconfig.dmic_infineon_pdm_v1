config AUDIO_DMIC_INFINEON_PDM_V1
	bool "Infineon PSOC 6 MXAUDIOSS v1 stereo DMIC"
	default y
	depends on SOC_CY8C624ABZI_S2D44
	depends on DT_HAS_INFINEON_PDM_V1_ENABLED
	select USE_INFINEON_PDM_PCM
	select PINCTRL
	help
	  Single-board PDMv1 driver using IRQ-driven interleaved signed 16-bit
	  stereo PCM slabs. Requires HF1 = 8 MHz. Supports 15625 frames/s only.

config DMIC_INFINEON_PDM_V1_QUEUE_SIZE
	int "PDMv1 completed PCM block queue length"
	depends on AUDIO_DMIC_INFINEON_PDM_V1
	default 8
	range 2 16
